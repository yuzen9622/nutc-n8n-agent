        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "campus-maintenance-synthetic",
          "name": "Campus synthetic maintenance"
        }
      },
      "retryOnFail": false
