      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\"data\":{\"synthetic\":true,\"delivered\":false,\"status\":\"unavailable\",\"message\":\"Agent 尚未就緒或結果驗證失敗，請檢查 credential 與執行紀錄。\"}}",
        "options": {}
      }
    },
    {
      "id": "note",
      "name": "部署狀態",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -340
      ],
      "parameters": {
        "content": "## 原生 n8n AI Agent 主流程\nWebhook → 驗證／去重 → 整理訊息 → AI Agent → 驗證／回覆\n下方是真實 Gemini、Postgres Chat Memory、PGVector、HTTP Request Tools 直接連線。PGVector 尚無語料；HTTP 工具目前為合成資料。Gemini credential 待補；目前容器仍禁止外連。此入口是內部測試 Webhook，不是 LINE 驗簽入口。",
        "width": 680,
        "height": 240
      }
    },
    {
      "id": "memory",
      "name": "Postgres Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.4,
      "position": [
        720,
        460
      ],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('整理訊息').first().json.sessionKey }}",
        "tableName": "agent_chat_histories",
        "contextWindowLength": 5
      },
      "credentials": {
        "postgres": {
          "id": "campus-agent-postgres",
          "name": "Campus Agent Postgres"
        }
      }
    },
