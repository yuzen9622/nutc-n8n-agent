{
  "id": "campusAgentToolweb",
  "name": "Campus Tool · web · synthetic",
  "active": false,
  "nodes": [
    {
      "id": "entry",
      "name": "工具輸入",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "taskId",
              "type": "string"
            },
            {
              "name": "capability",
              "type": "string"
            },
            {
              "name": "query",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "fetch",
      "name": "執行受控工具",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://mock-gateway:3000/internal/v1/agent/tool",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({taskId:$json.taskId,capability:$json.capability,kind:'web',query:$json.query}) }}",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "campus-task-synthetic",
          "name": "Campus synthetic task"
        }
      },
      "retryOnFail": false
    },
    {
      "id": "result",
      "name": "只回工具結果",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        520,
        0
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify($json.data) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "工具輸入": {
      "main": [
        [
          {
            "node": "執行受控工具",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "執行受控工具": {
      "main": [
        [
          {
            "node": "只回工具結果",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 90,
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {}
}
