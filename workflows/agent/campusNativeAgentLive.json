        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({lease:$('整理訊息').first().json.lease,taskId:$('整理訊息').first().json.taskId,capability:$('整理訊息').first().json.capability,kind:'web',query:$fromAI('query', '要搜尋的公開校園問題，不含私人資料', 'string')}) }}",
        "options": {
          "timeout": 10000
        },
        "toolDescription": "使用 Gemini 官方 Google Search 查詢並統整中科大公開時效資訊。僅傳公開 query。grounded_answer_ready 表示後端將提供完整答案、來源及搜尋建議，不需重新摘要或編造 sourceId。"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "campus-live-service",
          "name": "Campus live service"
        }
      },
      "retryOnFail": false
    }
