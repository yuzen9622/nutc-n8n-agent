      "parameters": {}
    },
    {
      "id": "E02",
      "name": "E02 只留監控識別",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        300,
        0
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify(({workflowId:String($json.workflow?.id || \"unknown\"),executionId:String($json.execution?.id || \"unknown\"),errorCode:\"WORKFLOW_FAILED\"})) }}",
        "options": {}
      }
    },
    {
      "id": "E03C",
      "name": "E03C 保存引用上下文",
