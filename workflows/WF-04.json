      "position": [
        970,
        0
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify(({...$('E03C 保存引用上下文').item.json, ...$json.data})) }}",
        "options": {}
      }
    },
    {
      "id": "ENOTE",
      "name": "ENOTE 資料邊界",
