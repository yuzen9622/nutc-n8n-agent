# Copy to .env. pnpm start:gateway loads it; existing process env takes precedence.
# All secret values belong in root .env. Secret files and *_FILE are not supported.
APP_MODE=live
HOST=127.0.0.1
PORT=3100
LINE_MESSAGING_CHANNEL_ID=2011885580
LINE_LOGIN_CHANNEL_ID=2011885607
# Messaging API bot user ID (U...), not either numeric channel ID.
# LINE_DESTINATION=U...
# LINE_CHANNEL_SECRET=...
# LINE_ACCESS_TOKEN=...
# LIFF_ID=2011885607-...
# PUBLIC_ORIGIN=https://your-public-host
# SESSION_SECRET=<unique random secret at least 32 characters>
# SERVICE_TOKEN=<different random secret at least 32 characters>
# DATABASE_URL=postgresql://...
LIVE_AGENT_ENABLED=false
N8N_WEBHOOK_URL=http://127.0.0.1:15679/webhook/campus-agent-live
# N8N_WEBHOOK_TOKEN=<separate random secret at least 32 characters>
# OFFICIAL_HOSTS_FILE=.local/official-hosts.json
# BRAVE_API_KEY=...
# All provider attempts reserve a verified upper bound before sending.
# User approved <= NTD 100 total, NOT USD 100. Keep zero until pricing is verified.
PROVIDER_DAILY_BUDGET_MICRO_USD=0
PROVIDER_TOTAL_BUDGET_MICRO_USD=0
BRAVE_REQUEST_MAX_MICRO_USD=0
# Native n8n Gemini credentials point at the budget proxy with its token.
# Real provider keys remain here; model availability/prices must be verified first.
# GEMINI_PROXY_TOKEN=<separate random secret at least 32 characters>
# GEMINI_CHAT_KEY=...
# GEMINI_EMBEDDING_KEY=...
# GEMINI_CHAT_MODEL=models/<verified-model-name>
# GEMINI_EMBEDDING_MODEL=models/<verified-embedding-name>
GEMINI_CHAT_MAX_COST_MICRO_USD=0
GEMINI_EMBEDDING_MAX_COST_MICRO_USD=0

# Independent school adapter. Only the gateway may call these internal endpoints.
SCHOOL_HOST=127.0.0.1
SCHOOL_PORT=3200
# SCHOOL_DATABASE_URL=postgresql://...
# SCHOOL_SERVICE_TOKEN=<unique random secret at least 32 characters>
# SCHOOL_SESSION_KEY=<64 hexadecimal characters; AES-256 key>
# SCHOOL_ACCOUNT_HASH_KEY=<different random secret at least 32 characters>

# Enable gateway binding only after school service deployment.
# SCHOOL_ORIGIN=http://127.0.0.1:3200


# Google 官方 Grounding，沿用 GEMINI_CHAT_KEY；須確認搜尋費用預留額後啟用。
GOOGLE_SEARCH_ENABLED=false
GOOGLE_SEARCH_MAX_COST_MICRO_USD=0
