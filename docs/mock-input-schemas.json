{
  "agent/prepare": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "eventId": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{1,100}$"
      },
      "scenario": {
        "type": "string",
        "enum": [
          "knowledge",
          "web",
          "personal",
          "mixed"
        ]
      },
      "session": {
        "default": "demo-a",
        "type": "string",
        "enum": [
          "demo-a",
          "demo-b"
        ]
      }
    },
    "required": [
      "eventId",
      "scenario",
      "session"
    ],
    "additionalProperties": false
  },
  "agent/tool": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "taskId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "capability": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "kind": {
        "type": "string",
        "enum": [
          "knowledge",
          "web",
          "personal"
        ]
      },
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "required": [
      "taskId",
      "capability",
      "kind",
      "query"
    ],
    "additionalProperties": false
  },
  "agent/complete": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "taskId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "capability": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "output": {
        "type": "string",
        "maxLength": 6000
      }
    },
    "required": [
      "taskId",
      "capability",
      "output"
    ],
    "additionalProperties": false
  },
  "demo": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "scenario": {
        "type": "string",
        "enum": [
          "public_success",
          "public_no_source",
          "schedule_success",
          "absence_success",
          "announcements_success",
          "reauth_required",
          "mixed_partial",
          "provider_timeout",
          "duplicate_event",
          "ocr_failed",
          "credential_invalid",
          "knowledge_success",
          "web_success",
          "both_success",
          "retrieval_retry",
          "retrieval_exhausted",
          "stale_knowledge",
          "source_conflict",
          "embedding_unavailable",
          "unknown_intent",
          "unknown_personal",
          "repair_success",
          "repair_failed",
          "unknown_route",
          "unknown_decision",
          "rewrite_denied",
          "session_expired",
          "binding_prompt",
          "clarify_prompt",
          "unsupported_prompt"
        ]
      }
    },
    "required": [
      "scenario"
    ],
    "additionalProperties": false
  },
  "empty": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "complete": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "resultRefs": {
        "minItems": 1,
        "maxItems": 2,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z]+_[a-f0-9-]{36}$"
        }
      }
    },
    "required": [
      "resultRefs"
    ],
    "additionalProperties": false
  },
  "fail": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "errorCode": {
        "type": "string",
        "enum": [
          "UPSTREAM_FAILED",
          "UNKNOWN_INTENT",
          "WORKFLOW_FAILED"
        ]
      }
    },
    "required": [
      "errorCode"
    ],
    "additionalProperties": false
  },
  "error": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "workflowId": {
        "type": "string",
        "maxLength": 100
      },
      "executionId": {
        "type": "string",
        "maxLength": 100
      },
      "errorCode": {
        "type": "string",
        "const": "WORKFLOW_FAILED"
      }
    },
    "required": [
      "workflowId",
      "executionId",
      "errorCode"
    ],
    "additionalProperties": false
  },
  "syncStart": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "scenario": {
        "default": "all",
        "type": "string",
        "enum": [
          "all",
          "updated",
          "unchanged",
          "withdrawn",
          "failed"
        ]
      }
    },
    "required": [
      "scenario"
    ],
    "additionalProperties": false
  },
  "sync": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "syncRef": {
        "type": "string",
        "pattern": "^[a-z]+_[a-f0-9-]{36}$"
      },
      "sourceRef": {
        "type": "string",
        "pattern": "^[a-z]+_[a-f0-9-]{36}$"
      },
      "versionRef": {
        "type": "string",
        "pattern": "^[a-z]+_[a-f0-9-]{36}$"
      }
    },
    "required": [
      "syncRef"
    ],
    "additionalProperties": false
  },
