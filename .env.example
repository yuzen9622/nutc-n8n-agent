# Compose is a synthetic-only local environment. No LINE / Gemini / school keys.
# Secret files are generated by node scripts/setup-secrets.mjs under .local/secrets.
# For optional direct host execution only (never production):
APP_MODE=synthetic
PORT=3000
MOCK_TASK_TOKEN_FILE=.local/secrets/task
MOCK_DEMO_TOKEN_FILE=.local/secrets/demo
MOCK_MAINTENANCE_TOKEN_FILE=.local/secrets/maintenance
MOCK_KNOWLEDGE_TOKEN_FILE=.local/secrets/knowledge
MOCK_OBSERVABILITY_TOKEN_FILE=.local/secrets/observability
# CLI runtime-check target:
N8N_BASE_URL=http://localhost:15679
