# 新環境範本；既有 .env 不覆寫、不換 key、不清空 volumes。
# Compose project: nutc-agent；改名不會搬移舊 volumes。
# 三個 PostgreSQL role 共用密碼；改此值不會更新既有 role。
POSTGRES_PASSWORD=

# 各自執行 openssl rand -hex 32 產生；既有環境保留原值。
APP_MASTER_KEY=
N8N_ENCRYPTION_KEY=

# 請替換為自己的 LINE／LIFF 設定。
LINE_MESSAGING_CHANNEL_ID=2011885580
LINE_LOGIN_CHANNEL_ID=2011885607
LINE_DESTINATION=
LINE_CHANNEL_SECRET=
LINE_ACCESS_TOKEN=
LIFF_ID=2011885607-MccunYXG
PUBLIC_ORIGIN=https://nutc-agent.yuzen.dev

# Dashboard managed Tunnel token；Compose 固定 origin http://gateway:3101。
# Dashboard 若有 remote ingress 也用 gateway:3101，勿用 private 3100／localhost。
CLOUDFLARE_TUNNEL_TOKEN=

# Google key／模型僅在 n8n editor 設定；搜尋驗收後才啟用。
GOOGLE_SEARCH_ENABLED=false

# 選用維護設定，不會自動建立 owner 或匯入工作流。
# 首次先於 editor 建立 owner，再 bash scripts/setup-n8n.sh。
N8N_BASE_URL=http://localhost:15679
N8N_OWNER_EMAIL=
N8N_OWNER_PASSWORD=
