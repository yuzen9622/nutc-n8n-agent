# Compose is a synthetic-only local environment. No LINE / Gemini / school keys.
# node scripts/setup-secrets.mjs appends generated secrets to root .env.
# For optional direct host execution only (never production):
APP_MODE=synthetic
PORT=3000
# MOCK_TASK_TOKEN=<generated in .env>
# MOCK_DEMO_TOKEN=<generated in .env>
# MOCK_MAINTENANCE_TOKEN=<generated in .env>
# MOCK_KNOWLEDGE_TOKEN=<generated in .env>
# MOCK_OBSERVABILITY_TOKEN=<generated in .env>
# CLI runtime-check target:
N8N_BASE_URL=http://localhost:15679

# Additional generated settings in the SAME root .env:
# POSTGRES_PASSWORD=
# DB_POSTGRESDB_PASSWORD=
# N8N_ENCRYPTION_KEY=
# AGENT_DB_PASSWORD=
# MOCK_WEBHOOK_TOKEN=
# N8N_OWNER_EMAIL=
# N8N_OWNER_PASSWORD=
# N8N_OWNER_FIRST_NAME=
# N8N_OWNER_LAST_NAME=
# TUNNEL_CRED_CONTENTS='<Cloudflare tunnel credentials JSON>'
# Live LINE/Brave/Gemini settings: see .env.live.example; use the same root .env.
