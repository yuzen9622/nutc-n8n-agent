# New environments only: copy to .env and fill required values.
# Never overwrite an existing .env. All secrets belong only in root .env.
# Docker URLs use postgres and campus_agent database/role.
# Use a URL-safe random hex AGENT_DB_PASSWORD and replace BOTH URL placeholders.
POSTGRES_PASSWORD=
DB_POSTGRESDB_PASSWORD=
AGENT_DB_PASSWORD=
# New environment: generate a separate 64-character hex key (openssl rand -hex 32).
# Keep this key stable: changing it makes existing n8n credentials unreadable.
N8N_ENCRYPTION_KEY=
DATABASE_URL=postgresql://campus_agent:REPLACE_WITH_AGENT_DB_PASSWORD@postgres:5432/campus_agent
SCHOOL_DATABASE_URL=postgresql://campus_agent:REPLACE_WITH_AGENT_DB_PASSWORD@postgres:5432/campus_agent
N8N_BASE_URL=http://localhost:15679
# Fresh Docker deployment auto-imports workflows/credentials and publishes the main workflow.
# Create the owner in the editor on first visit; these optional values are only
# used by local n8n maintenance scripts AFTER that setup, not to auto-create an owner.
N8N_OWNER_EMAIL=
N8N_OWNER_PASSWORD=

APP_MODE=live
HOST=127.0.0.1
PORT=3100
# Separate random secrets, each at least 32 characters.
SESSION_SECRET=
SERVICE_TOKEN=
N8N_WEBHOOK_TOKEN=
GEMINI_PROXY_TOKEN=
LINE_MESSAGING_CHANNEL_ID=2011885580
LINE_LOGIN_CHANNEL_ID=2011885607
LINE_DESTINATION=
LINE_CHANNEL_SECRET=
LINE_ACCESS_TOKEN=
LIFF_ID=2011885607-MccunYXG
PUBLIC_ORIGIN=https://nutc-agent.yuzen.dev
N8N_WEBHOOK_URL=http://127.0.0.1:15679/webhook/campus-agent-live

# School adapter: internal Docker URLs are set by Compose.
SCHOOL_HOST=127.0.0.1
SCHOOL_PORT=3200
SCHOOL_ORIGIN=http://127.0.0.1:3200
SCHOOL_SERVICE_TOKEN=
# AES-256 key: exactly 64 hexadecimal characters.
SCHOOL_SESSION_KEY=
SCHOOL_ACCOUNT_HASH_KEY=

# Real provider keys stay in gateway, not n8n credentials.
GEMINI_CHAT_KEY=
GEMINI_EMBEDDING_KEY=
GEMINI_CHAT_MODEL=models/gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# Worker starts automatically; provider costs are billed by Google without app caps.
# Google Search is independently optional.
GOOGLE_SEARCH_ENABLED=false
# Optional host tunnel; pnpm start:tunnel materializes a process-local temp config.
# TUNNEL_CRED_CONTENTS='<Cloudflare tunnel credentials JSON>'
